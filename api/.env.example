# Copie para api/.env e ajuste. O Bun carrega o .env automaticamente.
PORT=3000
# Origem exata do frontend (CORS e verificação de Origin)
WEB_ORIGIN=http://localhost:5173
# Em produção use NODE_ENV=production para o cookie de sessão receber o atributo Secure
NODE_ENV=development
# Diretório do banco SQLite (padrão: api/data)
# DATA_DIRECTORY=./data
